{
    "version": "2.0.0",  // VSCode 任务配置版本，固定不用改
    "tasks": [           // 任务列表（我们只写一个编译任务）
        {
            "label": "gcc build",    // 任务名字，必须和 launch 里对应
            "type": "shell",         // 在终端（WSL shell）里执行命令
            "command": "gcc",        // 要执行的命令：调用 gcc 编译器

            "args": [                // 传给 gcc 的参数（重点！）
                "-g",                // 必须加！生成调试信息（断点靠它）
                "${fileDirname}/*.c",// 编译当前文件夹下【所有】.c文件
                "-o",                // 指定输出文件名
                "${fileDirname}/test"// 输出到当前文件夹，叫 test
            ],

            "group": {
                "kind": "build",     // 标记这是【构建/编译】任务
                "isDefault": true    // 设置为默认任务，F5 自动找它
            }
        }
    ]
}