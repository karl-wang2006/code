{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc 编译链表项目",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/*.c",
                "-o",
                "${workspaceFolder}/link_list_test"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "仅编译项目，生成带调试信息的可执行文件，供调试使用"
        },
        {
            "type": "shell",
            "label": "编译并运行链表项目",
            "command": "gcc -fdiagnostics-color=always -g ${workspaceFolder}/*.c -o ${workspaceFolder}/link_list_test && ${workspaceFolder}/link_list_test",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "编译后自动运行程序，直接查看输出结果"
        }
    ]
}